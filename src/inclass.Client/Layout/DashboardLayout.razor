@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using inclass.Client.Components.Reuse
@inject NavigationManager NavigationManager

<div class="dashboard-shell @(IsSidebarCollapsed ? "sidebar-collapsed" : "") @(IsMobileMenuOpen ? "mobile-open" : "")">

    <!-- ── Sidebar ──────────────────────────────────────────────────────── -->
    <aside class="sidebar">
        <!-- Logo -->
        <div class="sidebar-logo">
            <span class="logo-text">InClass</span>
        </div>
        <nav class="sidebar-nav">
            <NavLink href="/dashboard" Match="NavLinkMatch.All" class="nav-item" ActiveClass="nav-item--active">
                <i class="fa-solid fa-gauge-high nav-icon"></i>
                <span class="nav-label">Dashboard</span>
            </NavLink>

            <NavLink href="/dashboard/schools" class="nav-item" ActiveClass="nav-item--active">
                <i class="fa-solid fa-school nav-icon"></i>
                <span class="nav-label">Schools</span>
            </NavLink>

            <!-- Expandable: Management -->
            <div class="nav-group @(IsManagementOpen ? "nav-group--open" : "")">
                <button class="nav-item nav-item--parent" @onclick="ToggleManagement">
                    <i class="fa-solid fa-layer-group nav-icon"></i>
                    <span class="nav-label">Management</span>
                    <i class="fa-solid fa-chevron-down nav-chevron"></i>
                </button>
                <div class="nav-children">
                    <div>
                        <NavLink href="/schools/create" class="nav-child" ActiveClass="nav-child--active">
                            Staff
                        </NavLink>
                        <NavLink href="/dashboard/management/students" class="nav-child" ActiveClass="nav-child--active">
                            Students
                        </NavLink>
                        <NavLink href="/dashboard/management/classes" class="nav-child" ActiveClass="nav-child--active">
                            Classes
                        </NavLink>
                    </div>
                </div>
            </div>

            <NavLink href="/dashboard/enrollments" class="nav-item" ActiveClass="nav-item--active">
                <i class="fa-solid fa-file-pen nav-icon"></i>
                <span class="nav-label">Enrollments</span>
            </NavLink>

            <NavLink href="/dashboard/reports" class="nav-item" ActiveClass="nav-item--active">
                <i class="fa-solid fa-chart-bar nav-icon"></i>
                <span class="nav-label">Reports</span>
            </NavLink>

            <NavLink href="/dashboard/settings" class="nav-item" ActiveClass="nav-item--active">
                <i class="fa-solid fa-gear nav-icon"></i>
                <span class="nav-label">Settings</span>
            </NavLink>

            <NavLink href="/dashboard/support" class="nav-item" ActiveClass="nav-item--active">
                <i class="fa-solid fa-circle-question nav-icon"></i>
                <span class="nav-label">Support</span>
            </NavLink>
        </nav>

        <!-- Bottom: Collapse -->
        <div class="sidebar-footer">
            <button class="collapse-btn" @onclick="HandleCollapseClick">
                <i class="fa-solid @(IsSidebarCollapsed ? "fa-angles-right" : "fa-angles-left") nav-icon"></i>
                <span class="nav-label">Collapse sidebar</span>
            </button>
        </div>
    </aside>

    <!-- Mobile overlay backdrop -->
    <div class="mobile-backdrop" @onclick="CloseMobileMenu"></div>

    <!-- ── Main area ─────────────────────────────────────────────────────── -->
    <div class="main-area">

        <!-- Topbar -->
        <header class="topbar">
            <!-- Mobile hamburger -->
            <button class="mobile-menu-btn" @onclick="ToggleMobileMenu">
                <i class="fa-solid fa-bars"></i>
            </button>

            <!-- Search -->
            <div class="topbar-search">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" placeholder="Quick search..." class="search-input" />
            </div>

            <!-- Right actions -->
            <div class="topbar-actions">
                <!-- Notifications -->
                <button class="action-icon-btn">
                    <i class="fa-regular fa-bell"></i>
                </button>

                <!-- User dropdown -->
                <div class="user-dropdown @(IsUserDropdownOpen ? "user-dropdown--open" : "")">
                    <button class="user-btn" @onclick="ToggleUserDropdown">
                        <AuthorizeView>
                            <Authorized Context="authState">
                                <span class="user-name">@GetFullName(authState.User)</span>
                            </Authorized>
                            <NotAuthorized>
                                <span class="user-name">Account</span>
                            </NotAuthorized>
                        </AuthorizeView>
                        <i class="fa-solid fa-chevron-down user-chevron"></i>
                    </button>

                    <div class="dropdown-menu">
                        <NavLink href="/dashboard/profile" class="dropdown-item" @onclick="CloseUserDropdown">
                            <i class="fa-regular fa-user"></i>
                            Profile
                        </NavLink>
                        <NavLink href="/dashboard/settings" class="dropdown-item" @onclick="CloseUserDropdown">
                            <i class="fa-solid fa-gear"></i>
                            Settings
                        </NavLink>
                        <div class="dropdown-divider"></div>
                        <button class="dropdown-item dropdown-item--danger" @onclick="SignOutAsync">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            Sign out
                        </button>
                    </div>
                </div>
            </div>
        </header>

        <!-- Page content -->
        <main class="page-content">
            <ToastContainer />
            @Body
        </main>
    </div>
</div>

@code {
    private bool IsSidebarCollapsed { get; set; } = false;
    private bool IsMobileMenuOpen { get; set; } = false;
    private bool IsUserDropdownOpen { get; set; } = false;
    private bool IsManagementOpen { get; set; } = false;

    private void ToggleSidebar() => IsSidebarCollapsed = !IsSidebarCollapsed;
    private void ToggleMobileMenu() => IsMobileMenuOpen = !IsMobileMenuOpen;
    private void CloseMobileMenu() => IsMobileMenuOpen = false;
    private void ToggleUserDropdown() => IsUserDropdownOpen = !IsUserDropdownOpen;
    private void CloseUserDropdown() => IsUserDropdownOpen = false;
    private void ToggleManagement() => IsManagementOpen = !IsManagementOpen;

    private static string GetFullName(ClaimsPrincipal user)
        => user.FindFirst(ClaimTypes.Name)?.Value ?? "User";

    private async Task SignOutAsync()
    {
        NavigationManager.NavigateTo("/auth/logout", forceLoad: true);
    }
    
    private void HandleCollapseClick()
    {
        if (IsMobileMenuOpen)
            CloseMobileMenu();
        else
            ToggleSidebar();
    }
}
