@* FieldEditorDrawer.razor — slide-over panel, Tailwind v4 only *@
@using inclass.Client.Services.Settings
@if (IsOpen && EditingField is not null)
{
    @* Backdrop *@
    <div class="fixed inset-0 bg-zinc-900/40 backdrop-blur-sm z-40" @onclick="HandleCancel"></div>

    @* Drawer *@
    <div class="fixed inset-y-0 right-0 w-full max-w-md bg-white z-50 flex flex-col shadow-2xl border-l border-zinc-200">

        @* Header *@
        <div class="flex items-center justify-between px-6 py-4 border-b border-zinc-200 bg-zinc-50 shrink-0">
            <div class="flex flex-col gap-1">
                <h3 class="text-[14px] font-semibold text-zinc-900">Modifier le champ</h3>
                <code class="text-[10px] font-mono text-indigo-600 bg-indigo-50 border border-indigo-100 px-2 py-0.5 rounded-md inline-block self-start">
                    @EditingField.Key
                </code>
            </div>
            <button @onclick="HandleCancel"
                class="w-8 h-8 flex items-center justify-center text-zinc-400 hover:text-zinc-700 hover:bg-zinc-200 rounded-lg transition-all">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        @* Body *@
        <div class="flex-1 overflow-y-auto px-6 py-5 space-y-5">

            @* Label *@
            <div class="flex flex-col gap-1.5">
                <label class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wider">Libellé</label>
                <input type="text" @bind="_d.Label"
                    class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-900 placeholder-zinc-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" />
            </div>

            @* Type *@
            <div class="flex flex-col gap-1.5">
                <label class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wider">Type de champ</label>
                <select @bind="_d.Type"
                    class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                    @foreach (var ft in Enum.GetValues<FieldType>())
                    {
                        <option value="@ft">@ft.ToLabel()</option>
                    }
                </select>
            </div>

            @* Placeholder (not for boolean) *@
            @if (_d.Type != FieldType.Boolean)
            {
                <div class="flex flex-col gap-1.5">
                    <label class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wider">Placeholder</label>
                    <input type="text" @bind="_d.Placeholder" placeholder="Ex: Entrez votre réponse…"
                        class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-900 placeholder-zinc-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all" />
                </div>
            }

            @* Hint *@
            <div class="flex flex-col gap-1.5">
                <label class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wider">
                    Texte d'aide <span class="normal-case font-normal text-zinc-400">(optionnel)</span>
                </label>
                <input type="text" @bind="_d.Hint" placeholder="Ex: Indiquez le prénom tel qu'il figure sur la CIN"
                    class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-900 placeholder-zinc-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all" />
            </div>

            @* Sort order *@
            <div class="flex flex-col gap-1.5">
                <label class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wider">Ordre</label>
                <input type="number" @bind="_d.SortOrder" min="0"
                    class="w-28 rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all" />
            </div>

            @* Required toggle *@
            <div class="flex items-center justify-between py-3 border-y border-zinc-100">
                <div>
                    <p class="text-[13px] font-medium text-zinc-700">Champ obligatoire</p>
                    <p class="text-[11px] text-zinc-400 mt-0.5">L'utilisateur doit renseigner ce champ</p>
                </div>
                <button @onclick="() => _d.IsRequired = !_d.IsRequired"
                    class="@(_d.IsRequired ? "bg-indigo-600" : "bg-zinc-200") relative inline-flex h-6 w-11 items-center rounded-full transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 shrink-0">
                    <span class="@(_d.IsRequired ? "translate-x-6" : "translate-x-1") inline-block h-4 w-4 rounded-full bg-white shadow-sm transition-transform duration-200"></span>
                </button>
            </div>

            @* Select options *@
            @if (_d.Type == FieldType.Select)
            {
                <div class="rounded-xl border border-zinc-200 overflow-hidden">
                    <div class="flex items-center justify-between px-4 py-2.5 bg-zinc-50 border-b border-zinc-200">
                        <span class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wider">Options</span>
                        <button @onclick="AddOpt"
                            class="text-[11px] font-semibold text-indigo-600 hover:text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 px-2.5 py-1 rounded-md transition-all">
                            + Ajouter
                        </button>
                    </div>
                    @if (_d.Options.Any())
                    {
                        @for (int i = 0; i < _d.Options.Count; i++)
                        {
                            var idx = i;
                            <div class="flex items-center gap-2 px-3 py-2 border-b border-zinc-100 last:border-0">
                                <input type="text" placeholder="valeur" value="@_d.Options[idx].Value"
                                    @oninput='e => _d.Options[idx].Value = e.Value?.ToString() ?? ""'
                                    class="flex-1 max-w-24 font-mono text-[12px] rounded-md border border-zinc-200 px-2 py-1.5 bg-zinc-50 text-zinc-800 focus:outline-none focus:ring-2 focus:ring-indigo-400 placeholder-zinc-300" />
                                <input type="text" placeholder="libellé" value="@_d.Options[idx].Label"
                                    @oninput='e => _d.Options[idx].Label = e.Value?.ToString() ?? ""'
                                    class="flex-1 text-[12px] rounded-md border border-zinc-200 px-2 py-1.5 bg-white text-zinc-800 focus:outline-none focus:ring-2 focus:ring-indigo-400 placeholder-zinc-300" />
                                <button @onclick="() => _d.Options.RemoveAt(idx)"
                                    class="w-6 h-6 flex items-center justify-center text-zinc-300 hover:text-red-500 hover:bg-red-50 rounded-md transition-all">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                                    </svg>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="px-4 py-4 text-[12px] text-zinc-400 text-center italic">Aucune option — cliquez sur Ajouter</p>
                    }
                </div>
            }

            @* Display condition *@
            <div class="rounded-xl border border-zinc-200 overflow-hidden">
                <div class="flex items-center justify-between px-4 py-3 bg-zinc-50 border-b border-zinc-200">
                    <div>
                        <p class="text-[12px] font-semibold text-zinc-700">Condition d'affichage</p>
                        <p class="text-[11px] text-zinc-400 mt-0.5">Afficher ce champ sous condition</p>
                    </div>
                    <button @onclick="ToggleCond"
                        class="@(_condEnabled ? "bg-indigo-600" : "bg-zinc-200") relative inline-flex h-6 w-11 items-center rounded-full transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 shrink-0">
                        <span class="@(_condEnabled ? "translate-x-6" : "translate-x-1") inline-block h-4 w-4 rounded-full bg-white shadow-sm transition-transform duration-200"></span>
                    </button>
                </div>
                @if (_condEnabled && _d.Condition is not null)
                {
                    <div class="px-4 py-4 flex flex-col gap-3 bg-white">
                        <div class="flex flex-col gap-1">
                            <label class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">Si le champ</label>
                            <select @bind="_d.Condition.FieldKey"
                                class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                @foreach (var k in AllFieldKeys)
                                {
                                    <option value="@k">@k</option>
                                }
                            </select>
                        </div>
                        <div class="flex gap-3">
                            <div class="flex flex-col gap-1 flex-1">
                                <label class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">Opérateur</label>
                                <select @bind="_d.Condition.Operator"
                                    class="w-full rounded-lg border border-zinc-300 bg-white px-2 py-2 text-[12px] text-zinc-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                    <option value="eq">= égal à</option>
                                    <option value="neq">≠ différent</option>
                                    <option value="gt">&gt; supérieur</option>
                                    <option value="lt">&lt; inférieur</option>
                                </select>
                            </div>
                            <div class="flex flex-col gap-1 flex-1">
                                <label class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">Valeur</label>
                                <input type="text" @bind="_d.Condition.Value" placeholder="ex: true"
                                    class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-900 placeholder-zinc-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all" />
                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>

        @* Footer *@
        <div class="px-6 py-4 border-t border-zinc-200 bg-zinc-50 flex justify-end gap-3 shrink-0">
            <button @onclick="HandleCancel"
                class="px-4 py-2 text-[13px] font-medium text-zinc-700 bg-white border border-zinc-300 rounded-lg hover:bg-zinc-50 transition-colors focus:outline-none focus:ring-2 focus:ring-zinc-400">
                Annuler
            </button>
            <button @onclick="HandleSave"
                class="px-5 py-2 text-[13px] font-semibold text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                Enregistrer
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public SchemaField? EditingField { get; set; }
    [Parameter] public List<string> AllFieldKeys { get; set; } = new();
    [Parameter] public EventCallback<SchemaField> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private SchemaField _d = new();
    private bool _condEnabled = false;

    protected override void OnParametersSet()
    {
        if (EditingField is null) return;
        _d = new SchemaField
        {
            Key = EditingField.Key, Label = EditingField.Label, Type = EditingField.Type,
            IsRequired = EditingField.IsRequired, Placeholder = EditingField.Placeholder,
            Hint = EditingField.Hint, SortOrder = EditingField.SortOrder,
            Options = EditingField.Options.Select(o => new SelectOption { Value = o.Value, Label = o.Label }).ToList(),
            Condition = EditingField.Condition is null ? null : new DisplayCondition
            {
                IsEnabled = EditingField.Condition.IsEnabled, FieldKey = EditingField.Condition.FieldKey,
                Operator = EditingField.Condition.Operator, Value = EditingField.Condition.Value
            }
        };
        _condEnabled = _d.Condition?.IsEnabled ?? false;
    }

    private void ToggleCond()
    {
        _condEnabled = !_condEnabled;
        if (_condEnabled && _d.Condition is null)
            _d.Condition = new DisplayCondition { IsEnabled = true };
        else if (_d.Condition is not null)
            _d.Condition.IsEnabled = _condEnabled;
    }

    private void AddOpt() => _d.Options.Add(new SelectOption());

    private async Task HandleSave()
    {
        if (_d.Condition is not null) _d.Condition.IsEnabled = _condEnabled;
        await OnSave.InvokeAsync(_d);
    }

    private async Task HandleCancel() => await OnCancel.InvokeAsync();
}
