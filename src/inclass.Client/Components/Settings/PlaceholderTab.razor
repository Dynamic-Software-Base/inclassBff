@* PlaceholderTab.razor *@
<div class="bg-white rounded-xl border border-zinc-200 shadow-xs p-16 flex flex-col items-center justify-center text-center min-h-80">
    <div class="text-4xl mb-4">@Icon</div>
    <h2 class="text-[15px] font-semibold text-zinc-800 mb-2">@Title</h2>
    <p class="text-[13px] text-zinc-400 max-w-xs">@Description</p>
    @if (IsDanger)
    {
        <div class="mt-5 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-600 text-[13px] max-w-xs">
            Contactez le support pour toute urgence.
        </div>
    }
    else
    {
        <span class="mt-5 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-zinc-100 text-zinc-400 text-[11px] font-medium">
            🚧 Bientôt disponible
        </span>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "📄";
    [Parameter] public string Title { get; set; } = "Section";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public bool IsDanger { get; set; } = false;
}