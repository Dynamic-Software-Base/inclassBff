@* SchoolSwitcher.razor *@
@inject SchoolContextService SchoolContext
@inject SchoolService SchoolService
@inject ApiResultHandler ResultHandler
@using Contract.InClass.Response.School
@using inclass.Client.Services
@using inclass.Client.Services.Schools
@implements IDisposable

@if (_loading)
{
    <div class="h-8 w-36 bg-zinc-100 animate-pulse rounded-lg"></div>
}
else if (SchoolContext.Schools.Count == 0)
{
    <span class="text-[12px] text-zinc-400">Aucun établissement</span>
}
else if (SchoolContext.Schools.Count == 1)
{
    <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-zinc-100 border border-zinc-200">
        <span class="text-[11px]">🏫</span>
        <span class="text-[13px] font-medium text-zinc-700">@SchoolContext.SelectedSchoolName</span>
        @if (SchoolContext.SelectedSchoolCity is not null)
        {
            <span class="text-[11px] text-zinc-400">— @SchoolContext.SelectedSchoolCity</span>
        }
    </div>
}
else
{
    <div class="relative">
        <button @onclick="Toggle"
            class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-zinc-100 hover:bg-zinc-200 border border-zinc-200 transition-all">
            <span class="text-[11px]">🏫</span>
            <span class="text-[13px] font-medium text-zinc-700 max-w-32 truncate">
                @SchoolContext.SelectedSchoolName
            </span>
            @if (SchoolContext.SelectedSchoolCity is not null)
            {
                <span class="text-[11px] text-zinc-400 hidden sm:inline">
                    — @SchoolContext.SelectedSchoolCity
                </span>
            }
            <svg class="w-3 h-3 text-zinc-400 transition-transform @(_open ? "rotate-180" : "")"
                fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
        </button>

        @if (_open)
        {
            <div class="absolute left-0 top-full mt-1 w-56 bg-white border border-zinc-200 rounded-xl shadow-lg z-50 overflow-hidden">
                @foreach (var school in SchoolContext.Schools)
                {
                    <button @onclick="() => SelectAsync(school)"
                        class="@(school.SchoolId == SchoolContext.SelectedSchoolId
                            ? "bg-indigo-50 text-indigo-700"
                            : "text-zinc-700 hover:bg-zinc-50")
                            w-full flex items-center justify-between px-4 py-2.5 text-[13px] transition-colors border-b border-zinc-100 last:border-0">
                        <div class="flex flex-col items-start">
                            <span class="font-medium">@school.Name</span>
                            @if (school.City is not null)
                            {
                                <span class="text-[11px] text-zinc-400">@school.City</span>
                            }
                        </div>
                        @if (school.SchoolId == SchoolContext.SelectedSchoolId)
                        {
                            <svg class="w-4 h-4 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                            </svg>
                        }
                    </button>
                }
            </div>
            <div class="fixed inset-0 z-40" @onclick="Close"></div>
        }
    </div>
}

@code {
    private bool _loading = true;
    private bool _open = false;

    protected override async Task OnInitializedAsync()
    {
        if (SchoolContext.Schools.Count == 0)
        {
            var response = await SchoolService.GetSwitcherSchools();
            var schools = ResultHandler.Handle(response);
            if (schools is not null)
                await SchoolContext.InitializeAsync(schools);
        }
        _loading = false;
        SchoolContext.OnChanged += StateHasChanged;
    }

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    private async Task SelectAsync(SchoolSwitcherDto school)
    {
        _open = false;
        await SchoolContext.SelectSchoolAsync(school);
    }

    public void Dispose() => SchoolContext.OnChanged -= StateHasChanged;
}