
@using inclass.Client.Services.Enroll
System
@using Contract.InClass.Response.Registration

<div class="@GetCardClasses() rounded-2xl border bg-white shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col overflow-hidden">

    @* Header *@
    <div class="flex items-start justify-between px-5 pt-5 pb-3">
        <div>
            <p class="font-bold text-slate-900 text-base leading-tight">@Session.GradeName_Fr</p>
            <p class="text-sm text-slate-400 mt-0.5" dir="rtl">@Session.GradeName_Ar</p>
        </div>
        @GetStatusBadge()
    </div>

    @* Progress bar *@
    <div class="px-5 pb-3">
        <div class="flex items-center justify-between mb-1.5">
            <span class="text-xs text-slate-500">Places disponibles</span>
            <span class="text-xs font-semibold @GetSlotsTextColor()">
                @GetAvailableSlots() / @Session.MaxSlots
            </span>
        </div>
        <div class="h-2 rounded-full bg-slate-100 overflow-hidden">
            <div class="h-full rounded-full transition-all duration-500 @GetProgressBarColor()"
                 style="width: @GetFillPercent()%"></div>
        </div>
        <p class="text-xs text-slate-500 mt-1.5">
            @GetAvailableSlots() place@(GetAvailableSlots() == 1 ? "" : "s") disponible@(GetAvailableSlots() == 1 ? "" : "s")
        </p>
    </div>

    @* Period *@
    <div class="px-5 pb-4 flex items-center gap-1.5 text-xs text-slate-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Du @FormatDate(Session.OpenDate) au @FormatDate(Session.CloseDate)
    </div>

    @* CTA *@
    <div class="px-5 pb-5 mt-auto">
        @GetCtaButton()
    </div>

</div>

@code {
    [Parameter] public EnrollmentSessionDto Session { get; set; } = default!;
    [Parameter] public EventCallback<SessionSelectedArgs> OnSelect { get; set; }

    private bool IsClosed => Session.SessionStatus != "Open";
    private bool IsFull => (Session.ReservedCount + Session.EnrolledCount) >= Session.MaxSlots;
    private bool IsReturningOnly =>
        Session.ActivePhaseType == "ReRegistration" && Session.ActivePhaseAllowedType == "ReturningOnly";
    private bool IsScheduled =>
        Session.ActivePhaseType == null && !IsClosed;

    private int GetAvailableSlots() =>
        Math.Max(0, Session.MaxSlots - Session.ReservedCount - Session.EnrolledCount);

    private double GetFillPercent()
    {
        if (Session.MaxSlots == 0) return 100;
        return Math.Min(100, (double)(Session.ReservedCount + Session.EnrolledCount) / Session.MaxSlots * 100);
    }

    private string GetProgressBarColor()
    {
        var pct = GetFillPercent();
        if (pct >= 90) return "bg-red-500";
        if (pct >= 70) return "bg-amber-400";
        return "bg-emerald-500";
    }

    private string GetSlotsTextColor()
    {
        var pct = GetFillPercent();
        if (pct >= 90) return "text-red-600";
        if (pct >= 70) return "text-amber-600";
        return "text-emerald-600";
    }

    private string GetCardClasses()
    {
        var opacity = IsClosed ? "opacity-60" : "";
        return $"relative {opacity}";
    }

    private string FormatDate(DateTime? date)
    {
        return date?.ToString("dd MMM yy") ?? "";
    }

    private RenderFragment GetStatusBadge() => __builder =>
    {
        if (IsClosed)
        {
            <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-500">Fermée</span>
        }
        else if (IsFull)
        {
            <span class="inline-flex items-center gap-1 rounded-full bg-red-50 border border-red-200 px-2.5 py-1 text-xs font-medium text-red-600">Complet</span>
        }
        else if (IsReturningOnly)
        {
            <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 border border-amber-200 px-2.5 py-1 text-xs font-medium text-amber-700">Réinscriptions uniquement</span>
        }
        else if (IsScheduled)
        {
            <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2.5 py-1 text-xs font-medium text-blue-700">Bientôt</span>
        }
        else
        {
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-1 text-xs font-medium text-emerald-700">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                Ouvert
            </span>
        }
    };

    private RenderFragment GetCtaButton() => __builder =>
    {
        if (IsClosed)
        {
            <button disabled class="w-full rounded-xl bg-slate-100 text-slate-400 font-medium text-sm py-2.5 cursor-not-allowed">
                Inscriptions fermées
            </button>
        }
        else if (IsFull)
        {
            <button @onclick="() => SelectSession(false)"
                    class="w-full rounded-xl bg-red-600 hover:bg-red-700 text-white font-medium text-sm py-2.5 transition-colors">
                Liste d'attente
            </button>
        }
        else if (IsReturningOnly)
        {
            <button @onclick="() => SelectSession(true)"
                    class="w-full rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-medium text-sm py-2.5 transition-colors">
                Je suis un élève réinscrit
            </button>
        }
        else if (IsScheduled)
        {
            <button disabled class="w-full rounded-xl bg-blue-50 border border-blue-200 text-blue-500 font-medium text-sm py-2.5 cursor-not-allowed">
                Ouvre le @FormatDate(Session.OpenDate)
            </button>
        }
        else
        {
            <button @onclick="() => SelectSession(false)"
                    class="w-full rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm py-2.5 transition-colors shadow-sm">
                S'inscrire
            </button>
        }
    };

    private async Task SelectSession(bool preSelectReturning)
    {
        await OnSelect.InvokeAsync(new SessionSelectedArgs(Session, preSelectReturning));
    }
}
