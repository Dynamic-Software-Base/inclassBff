@using Contract.InClass.Response.Registration
<div class="space-y-6">
    <div>
        <h3 class="text-lg font-bold text-slate-900">Quel type d'inscription souhaitez-vous effectuer ?</h3>
        <p class="text-sm text-slate-500 mt-1">Sélectionnez la situation qui correspond à votre enfant.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

        @* New student card *@
        @if (IsReturningOnly)
        {
            <div class="relative rounded-2xl border-2 border-slate-200 bg-slate-50 p-5 opacity-60 cursor-not-allowed select-none">
                <div class="absolute top-3 right-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-slate-200 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
                <p class="font-bold text-slate-600">Nouvelle inscription</p>
                <p class="text-xs text-slate-400 mt-1">Premier enregistrement dans cette école</p>
                <p class="text-xs text-amber-600 font-medium mt-3 bg-amber-50 rounded-lg px-2 py-1.5">
                    Réservé aux réinscriptions — phase en cours
                </p>
            </div>
        }
        else
        {
            <button @onclick="OnSelectNew"
                    class="group text-left rounded-2xl border-2 border-slate-200 hover:border-indigo-500 bg-white hover:bg-indigo-50 p-5 transition-all duration-200 focus:outline-none focus:border-indigo-500">
                <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-indigo-100 group-hover:bg-indigo-200 mb-4 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
                <p class="font-bold text-slate-900">Nouvelle inscription</p>
                <p class="text-sm text-slate-500 mt-1">Premier enregistrement dans cette école</p>
                <div class="mt-4 flex items-center gap-1.5 text-xs text-indigo-600 font-medium opacity-0 group-hover:opacity-100 transition-opacity">
                    Continuer
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </div>
            </button>
        }

        @* Returning student card *@
        <button @onclick="OnSelectReturning"
                class="group text-left rounded-2xl border-2 border-slate-200 hover:border-emerald-500 bg-white hover:bg-emerald-50 p-5 transition-all duration-200 focus:outline-none focus:border-emerald-500">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-emerald-100 group-hover:bg-emerald-200 mb-4 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
            </div>
            <p class="font-bold text-slate-900">Réinscription</p>
            <p class="text-sm text-slate-500 mt-1">L'élève était inscrit dans cette école l'année précédente</p>
            <div class="mt-4 flex items-center gap-1.5 text-xs text-emerald-600 font-medium opacity-0 group-hover:opacity-100 transition-opacity">
                Continuer
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
            </div>
        </button>

    </div>
</div>

@code {
    [Parameter] public EnrollmentSessionDto Session { get; set; } = default!;
    [Parameter] public EventCallback OnSelectNew { get; set; }
    [Parameter] public EventCallback OnSelectReturning { get; set; }

    private bool IsReturningOnly =>
        Session.ActivePhaseType == "ReRegistration" && Session.ActivePhaseAllowedType == "ReturningOnly";
}
