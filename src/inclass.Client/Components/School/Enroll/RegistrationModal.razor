@using System.Text.Json
@using System.Threading.Tasks
@using Contract.InClass.Response.Registration

<div class="fixed inset-0 z-50 flex items-center justify-center p-4">
    @* Backdrop *@
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" @onclick="TryClose"></div>

    @* Modal panel *@
    <div class="relative z-10 w-full max-w-3xl max-h-[90vh] overflow-y-auto rounded-2xl bg-white shadow-2xl flex flex-col">

        @* Modal header *@
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 sticky top-0 bg-white z-10">
            <div>
                <p class="text-xs text-slate-400 uppercase tracking-wide font-medium">Demande d'inscription</p>
                <h2 class="font-bold text-slate-900 text-base leading-tight mt-0.5">
                    @Session.GradeName_Fr
                    <span class="font-normal text-slate-400 text-sm ml-1" dir="rtl">@Session.GradeName_Ar</span>
                </h2>
            </div>
            <button @onclick="TryClose"
                    disabled="@_submitting"
                    class="flex items-center justify-center w-8 h-8 rounded-full text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        @* Step indicator (hidden on step 5) *@
        @if (_currentStep < 5)
        {
            <div class="px-6 py-3 border-b border-slate-100 bg-slate-50">
                <div class="flex items-center gap-2">
                    @for (int i = 1; i <= 4; i++)
                    {
                        var step = i; // capture for closure
                        <div class="flex items-center @(step < 4 ? "flex-1" : "")">
                            <div class="flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold border-2 transition-all
                                        @(step < _currentStep ? "bg-indigo-600 border-indigo-600 text-white"
                                          : step == _currentStep ? "border-indigo-600 text-indigo-600 bg-white"
                                          : "border-slate-200 text-slate-400 bg-white")">
                                @if (step < _currentStep)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                    </svg>
                                }
                                else
                                {
                                    @step
                                }
                            </div>
                            @if (step < 4)
                            {
                                <div class="flex-1 h-px mx-2 @(step < _currentStep ? "bg-indigo-600" : "bg-slate-200") transition-colors"></div>
                            }
                        </div>
                    }
                </div>
                <div class="flex justify-between mt-1 text-[10px] text-slate-400">
                    <span>Type</span>
                    <span>Identité</span>
                    <span>Formulaire</span>
                    <span>Récapitulatif</span>
                </div>
            </div>
        }

        @* Step content *@
        <div class="flex-1 px-6 py-6">
            @if (_currentStep == 1)
            {
                <Step1_ApplicationType
                    Session="@Session"
                    OnSelectNew="@HandleSelectNew"
                    OnSelectReturning="@HandleSelectReturning" />
            }
            else if (_currentStep == 2)
            {
                <Step2_IdentityLookup
                    Session="@Session"
                    IsReturning="@_isReturning"
                    IdentityKey="@_identityKey"
                    IdentityKeyChanged="@(v => _identityKey = v)"
                    OnPrefillSuccess="@HandlePrefillSuccess"
                    OnContinueAsNew="@HandleContinueAsNew"
                    OnBack="@(() => GoToStep(1))" />
            }
            else if (_currentStep == 3)
            {
                <Step3_DynamicForm
                    SchemaJson="@_loadedSchemaJson"
                    IsReturning="@_isReturning"
                    PrefillData="@_prefillData"
                    FormValues="@_formValues"
                    OnNext="@HandleFormNext"
                    OnBack="@HandleFormBack" />
            }
            else if (_currentStep == 4)
            {
                <Step4_Review
                    Session="@Session"
                    SchoolName="@SchoolName"
                    AcademicYear="@AcademicYear"
                    IsReturning="@_isReturning"
                    FirstName="@_firstName"
                    LastName="@_lastName"
                    Phone="@_phone"
                    Email="@_email"
                    FormValues="@_formValues"
                    Submitting="@_submitting"
                    SubmitError="@_submitError"
                    OnConfirm="@HandleSubmit"
                    OnBack="@(() => GoToStep(3))" />
            }
            else if (_currentStep == 5)
            {
                <Step5_Confirmation
                    Session="@Session"
                    SchoolName="@SchoolName"
                    ApplicationId="@_submittedApplicationId"
                    IdentityKey="@_submittedIdentityKey"
                    OnClose="@OnClose"
                    OnEnrollAnother="@HandleEnrollAnother" />
            }
        </div>
    </div>
</div>

