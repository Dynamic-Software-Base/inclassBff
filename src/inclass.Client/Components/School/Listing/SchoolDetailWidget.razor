@using Contract.InClass.Response.School
@* SchoolDetailWidget.razor *@
@inject NavigationManager Nav

@if (School is null)
{
    @* Empty state *@
    <div class="flex flex-col items-center justify-center h-full min-h-96 text-center p-10">
        <div class="w-24 h-24 mb-5 rounded-2xl bg-indigo-50 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-indigo-200" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                      d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
        </div>
        <p class="text-slate-500 font-medium text-sm">Sélectionnez une école pour voir les détails</p>
        <p class="text-slate-400 text-xs mt-1">Cliquez sur une carte pour explorer</p>
    </div>
}
else
{
    <div class="overflow-y-auto h-full pb-8" @key="School.SchoolId">

        @* Hero image *@
        @{
            var mainPic = School.Pictures.FirstOrDefault(p => p.IsMain) ?? School.Pictures.FirstOrDefault();
            var initials = string.Join("", School.Name
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2).Select(w => char.ToUpper(w[0])));
        }

        <div class="relative w-full h-48 rounded-xl overflow-hidden mb-5 bg-gradient-to-br from-indigo-100 to-indigo-200 flex items-center justify-center shadow-sm">
            @if (mainPic is not null)
            {
                <img src="@mainPic.Url" alt="@School.Name" class="w-full h-full object-cover" />
            }
            else
            {
                <span class="text-5xl font-bold text-indigo-300/60 select-none">@initials</span>
            }
        </div>

        @* Header *@
        <div class="flex items-start justify-between gap-4 px-1">
            <div class="flex-1 min-w-0">
                <h2 class="text-xl font-bold text-slate-900 leading-tight">@School.Name</h2>
                @if (!string.IsNullOrWhiteSpace(School.ArName))
                {
                    <p class="text-sm text-slate-400 mt-0.5" dir="rtl" lang="ar">@School.ArName</p>
                }
                <div class="flex items-center gap-1 mt-1 text-xs text-slate-500">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>@School.City</span>
                    @if (School.Latitude.HasValue && School.Longitude.HasValue)
                    {
                        <span class="text-slate-300 mx-1">·</span>
                        <span class="font-mono text-slate-400 text-xs">
                            @School.Latitude.Value.ToString("F4"), @School.Longitude.Value.ToString("F4")
                        </span>
                    }
                </div>

                @* Grade pills *@
                <div class="flex flex-wrap gap-1 mt-2">
                    @if (School.GradeLevelOffering.HasPreSchool)
                    {
                        <span class="text-xs px-2 py-0.5 rounded-full bg-purple-100 text-purple-700 font-medium">Préscolaire</span>
                    }
                    @if (School.GradeLevelOffering.HasPrimarySchool)
                    {
                        <span class="text-xs px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 font-medium">Primaire</span>
                    }
                    @if (School.GradeLevelOffering.HasMiddleSchool)
                    {
                        <span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 font-medium">Collège</span>
                    }
                    @if (School.GradeLevelOffering.HasHighSchool)
                    {
                        <span class="text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700 font-medium">Lycée</span>
                    }
                </div>
            </div>

            @* S'inscrire CTA *@
            @if (School.OpenSessions.Count > 0)
            {
                <button
                    class="shrink-0 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2 rounded-xl shadow-sm transition"
                    @onclick="NavigateToEnroll">
                    S'inscrire
                </button>
            }
        </div>

        <hr class="my-5 border-slate-100" />

        @* About *@
        <div class="px-1">
            <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wider mb-2">À propos</h3>
            @if (!string.IsNullOrWhiteSpace(School.Description))
            {
                <p class="text-sm text-slate-600 leading-relaxed">@School.Description</p>
            }
            else
            {
                <p class="text-sm text-slate-400 italic">Aucune description disponible</p>
            }
        </div>

        @* Enrollment sessions *@
        <div class="px-1">
            <EnrollmentSessionsSection Sessions="@School.OpenSessions" />
        </div>

        @* Map *@
        <div class="px-1">
            <SchoolMapWidget
                @key="@School.SchoolId"
                SchoolName="@School.Name"
                City="@School.City"
                Latitude="@School.Latitude"
                Longitude="@School.Longitude" />
        </div>
    </div>
}

@code {
    [Parameter] public SchoolSummaryDto? School { get; set; }

    private void NavigateToEnroll()
    {
        if (School is not null)
            Nav.NavigateTo($"/enroll/{School.SchoolId}");
    }
}
