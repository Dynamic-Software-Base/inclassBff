@* SchoolMapWidget.razor — Redesigned *@
@using Microsoft.JSInterop
@inject IJSRuntime JS

@if (Latitude.HasValue && Longitude.HasValue)
{
    <div class="map-section">
        <div class="map-label">
            <span class="map-label__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" />
                    <circle cx="12" cy="9" r="2.5" stroke-width="1.5" />
                </svg>
            </span>
            <span class="map-label__text">Localisation</span>
        </div>

        <div class="map-wrapper">
            <div id="@MapId" class="map-canvas"></div>

            @* Floating info chip *@
            <div class="map-chip">
                <span class="map-chip__dot"></span>
                <span>@SchoolName@(City is not null ? $", {City}" : "")</span>
            </div>
        </div>

        <div class="map-coords">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <circle cx="12" cy="12" r="3" stroke-width="2"/>
                <path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span>@Latitude?.ToString("F5")° N &nbsp;·&nbsp; @Longitude?.ToString("F5")° E</span>
        </div>
    </div>
}

<style>
    .map-section {
        margin-top: 2rem;
    }

    .map-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .map-label__icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 0.5rem;
        background: #f0edf8;
    }

    .map-label__icon svg {
        width: 0.9rem;
        height: 0.9rem;
        stroke: #6d54b5;
    }

    .map-label__text {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #7c6fa0;
    }

    .map-wrapper {
        position: relative;
        border-radius: 1rem;
        overflow: hidden;
        border: 1px solid #e8e3f4;
        box-shadow: 0 4px 24px 0 rgba(109, 84, 181, 0.07);
    }

    .map-canvas {
        height: 260px;
        width: 100%;
    }

    .map-chip {
        position: absolute;
        bottom: 0.75rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 0.45rem;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(109, 84, 181, 0.15);
        border-radius: 999px;
        padding: 0.35rem 0.9rem;
        font-size: 0.7rem;
        font-weight: 600;
        color: #3d2f6b;
        white-space: nowrap;
        box-shadow: 0 2px 12px rgba(61, 47, 107, 0.12);
        pointer-events: none;
    }

    .map-chip__dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 50%;
        background: #6d54b5;
        flex-shrink: 0;
        box-shadow: 0 0 0 2px rgba(109, 84, 181, 0.25);
    }

    .map-coords {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        margin-top: 0.5rem;
        padding: 0 0.25rem;
        font-size: 0.65rem;
        color: #a89ccc;
        font-variant-numeric: tabular-nums;
        font-family: 'Fira Mono', 'Cascadia Code', monospace;
    }

    .map-coords svg {
        stroke: #c4b8e8;
        flex-shrink: 0;
    }
</style>

@code {
    [Parameter, EditorRequired] public string SchoolName { get; set; } = "";
    [Parameter] public string? City { get; set; }
    [Parameter] public double? Latitude { get; set; }
    [Parameter] public double? Longitude { get; set; }

    private string MapId => $"map-{_mapKey}";
    private string _mapKey = Guid.NewGuid().ToString("N")[..8];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Latitude.HasValue && Longitude.HasValue)
            await InitMap();
    }

    protected override async Task OnParametersSetAsync()
    {
        _mapKey = Guid.NewGuid().ToString("N")[..8];
        await Task.CompletedTask;
    }

    private async Task InitMap()
    {
        if (!Latitude.HasValue || !Longitude.HasValue) return;
        await JS.InvokeVoidAsync("initLeafletMap",
            MapId, Latitude.Value, Longitude.Value, SchoolName, City ?? "");
    }
}
